NATS_URL=nats://localhost:4222
# Local development only. Use NATS_CREDS_FILE in production.
NATS_USER=inquiry-to-commerce
NATS_PASSWORD=inquiry-to-commerce-dev
# NATS_CREDS_FILE=/run/secrets/inquiry-to-commerce.creds
COMMERCE_BASE_URL=http://localhost:8080
COMMERCE_SERVICE_ID=replace-with-dedicated-service-uuid
COMMERCE_SERVICE_SECRET=replace-with-dedicated-service-secret
# Alternatively mount a secret and set COMMERCE_SERVICE_SECRET_FILE (not both).
# COMMERCE_SERVICE_SECRET_FILE=/run/secrets/commerce-service.secret
