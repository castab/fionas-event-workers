{
  "name": "fionas-event-workers",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26 <27" },
  "workspaces": ["workers/*", "packages/*"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p workers/inquiry-to-commerce/tsconfig.json",
    "test": "node --test workers/inquiry-to-commerce/tests/*.test.ts",
    "test:integration": "node --test workers/inquiry-to-commerce/tests/integration/*.test.ts",
    "start": "npm start --workspace @fionas/inquiry-to-commerce",
    "nats:setup": "node scripts/nats-setup.ts",
    "nats:up": "docker compose up -d --wait nats",
    "nats:down": "docker compose down"
  },
  "devDependencies": { "@types/node": "26.6.5", "typescript": "7.0.2" }
}
